# MaxiMall web orchestrator — production .env additions for the AI consultant (branch artur-ai-integration).
# Append the lines you need to the SERVER's /opt/maximall-web/.env (it already holds AWS_*, ADMIN_*, TUNNEL_REPORT_SECRET).
# Names and recommended values only — never commit real keys. docker-compose passes the whole .env to the app container.
#
# ─── Pre-deploy requirements created by the security fixes (apply even with AI off) ───────────────────────────────────
# ADMIN_PASSWORD_HASH must be NON-EMPTY: empty now refuses every admin login (it used to accept an empty password).
#   A bcrypt hash ($2b$...) is verified with bcrypt; any other value is treated as the plaintext password (constant time).
#   Generate a hash:  docker compose exec app node -e "console.log(require('bcrypt').hashSync(process.argv[1], 12))" '<password>'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=<bcrypt hash or the current plaintext password>
# SESSION_SECRET: when unset the server now uses a random per-process secret (admins are logged out on every restart)
#   instead of the public default 'secret'. Set a long random value:  openssl rand -hex 32
SESSION_SECRET=<64 random hex chars>
# Admin API origin check: requests to /api/admin/* that carry an Origin header must come from the backend's own origin
# (scheme://Host as seen through nginx) or one listed here (comma-separated).
PUBLIC_ORIGIN=https://18-185-5-251.nip.io
# Failed admin logins per client address per 15 min before 429 (default 10).
ADMIN_LOGIN_MAX_FAILURES_15MIN=10
# Never set in production: LOCAL_MODE, LOCAL_ADMIN_PASSWORD, AI_RENDER_MOCK_HANG.
#
# ─── UE project saves: one-time migration ─────────────────────────────────────────────────────────────────────────────
# docker-compose now mounts ./data/saves at /app/dist/data/saves (saves used to live only inside the container and were
# lost on every rebuild). terraform/windows-deploy.ps1 copies them out of the running container first; if you deploy by
# hand, run BEFORE `docker compose up --build`:
#   mkdir -p data/saves && docker cp pixel-connector:/app/dist/data/saves/. data/saves/
#
# ─── AI consultant on/off ─────────────────────────────────────────────────────────────────────────────────────────────
# Off (unset / 0) = the pre-AI server: no AI module, no /ai namespace, no AI routes; GET /api/ai/health -> {"ok":true,"enabled":false}.
AI_ENABLED=1
# Base for every link the AI hands out (voice clips, photos, dossier PDF / short link / QR). Unset = http://localhost:PORT
# (broken for visitors; the server logs a loud warning at start).
PUBLIC_BASE_URL=https://18-185-5-251.nip.io
#
# ─── Paid providers and budget ────────────────────────────────────────────────────────────────────────────────────────
# Real providers run only when their key is set AND AI_PAID_CALLS_APPROVED=1 AND AI_FORCE_MOCK is not 1. 0 = mocks only.
AI_PAID_CALLS_APPROVED=0
# 1 = every provider mocked regardless of keys (safe switch). Leave unset/0 for a live consultant.
AI_FORCE_MOCK=0
# No paid AI renders until the owner approves the captures (P3-03): keep 1.
AI_RENDER_FORCE_MOCK=1
# Total $ cap over the whole ledger, and per visitor session. An EMPTY value = 0 = every paid call refused; a
# non-numeric / negative value falls back to the default (50 / 1.5) with a warning (it used to disable the cap).
AI_BUDGET_USD=20
AI_SESSION_CAP_USD=1.5
# Spend ledger on the persisted volume (docker-compose sets this already; keep it there).
AI_SPEND_LOG=/app/data/runtime/api_spend.jsonl
#
# Provider keys (empty = that provider stays mocked). Set them only on the server, never in git.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=
GEMINI_API_KEY=
SIMLI_API_KEY=
# Voice / avatar identities (not secrets). Fill in the voice and face chosen for the Expo.
ELEVENLABS_VOICE_ID=<voice id>
SIMLI_FACE_ID=<face id>
# Optional model / price overrides (defaults shown).
# AI_LLM_MODEL=claude-sonnet-5-5
# AI_LLM_TIMEOUT_MS=12000
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v1
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# SIMLI_MAX_SESSION_LENGTH=1800
# SIMLI_MAX_IDLE_TIME=300
#
# ─── Dossier PDF (headless Chromium in the image) ─────────────────────────────────────────────────────────────────────
# Empty = auto (/usr/bin/chromium-browser from `apk add chromium`). --no-sandbox is added automatically as root.
CHROME_PATH=
#
# ─── Session binding, limits, retention (defaults shown) ──────────────────────────────────────────────────────────────
# 1 = the page must send the pool hostToken in ai.session.start (CR-AI-06). Keep 0 until the deployed player page sends it.
AI_REQUIRE_HOST_TOKEN=0
# /ai sessions: a disconnected session idle this long is dropped (a reconnect inside the window resumes it); hard cap.
AI_SESSION_IDLE_MIN=120
AI_MAX_SESSIONS=2000
AI_SESSION_SWEEP_MIN=5
AI_TURNS_PER_SESSION_MIN=15
AI_AUDIO_STARTS_PER_SESSION_MIN=20
AI_RENDER_MAX_PER_SESSION_10MIN=12
AI_RENDER_MAX_PER_IP_10MIN=60
AI_DOSSIER_MAX_PER_SESSION_10MIN=5
AI_DOSSIER_MAX_PER_IP_10MIN=30
AI_VISIT_MAX_PER_IP_10MIN=10
AI_AVATAR_TOKENS_PER_IP_10MIN=30
AI_AVATAR_TOKENS_PER_SESSION_10MIN=6
# Runtime data retention (renders, clips, dossier files, logs) — on by default in production; never touches leads,
# the ledger, the catalog or saves. Ages in days: see .env.example (AI_RETENTION_*_DAYS).
AI_RETENTION_ENABLED=1
AI_RETENTION_INTERVAL_MIN=60
