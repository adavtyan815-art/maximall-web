{
  "name": "pixelstreaming-backend-multi",
  "version": "1.0.0",
  "description": "Multi-Instance 3D Streaming Platform with WebSocket Communication",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --ignore src/data/ src/server.ts",
    "build": "tsc",
    "seed": "ts-node scripts/seed-instances.ts",
    "test": "vitest run",
    "scrape:oliveeka": "tsx scripts/scrape-oliveeka.ts",
    "typecheck": "tsc --noEmit -p .",
    "build:catalog": "tsx scripts/build-catalog-index.ts",
    "smoke:golden": "tsx scripts/_smoke.ts",
    "dev:local": "tsx src/server.ts",
    "harness:mock": "tsx scripts/phrase-harness.ts",
    "dossier:preview": "tsx scripts/dossier-preview.ts",
    "report:expo": "tsx scripts/expo-report.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@aws-sdk/client-ec2": "^3.500.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-session": "^1.18.0",
    "mongoose": "^9.4.1",
    "multer": "^2.4.0",
    "puppeteer-core": "^25.12.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.8.3",
    "uuid": "^9.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^9.0.8",
    "nodemon": "^3.0.3",
    "pdfjs-dist": "^6.3.289",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vitest": "^5.0.3"
  }
}
