PORT=3000
NODE_ENV=development

# AWS Configuration
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-2
AWS_SECURITY_GROUP_ID=sg-xxxxx
AWS_SUBNET_ID=subnet-xxxxx
AWS_AMI_ID=ami-xxxxx
DEFAULT_INSTANCE_TYPE=g4dn.2xlarge
# Extra instance types tried when DEFAULT_INSTANCE_TYPE has no capacity in any AZ (comma list, in order).
# AMI must carry an NVIDIA driver for the chosen GPU (g6 = L4, g4dn = T4). Owner decision 2026-10-07: g4dn.2xlarge, no fallback (empty).
FALLBACK_INSTANCE_TYPES=
# Full rounds over all types/AZs before giving up (20 s apart).
LAUNCH_RETRY_ROUNDS=3

# Admin Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$10$...
SESSION_SECRET=your_random_secret_here

# Session
HEARTBEAT_TIMEOUT_MS=30000
GRACE_PERIOD_MS=60000
SESSION_CLEANUP_INTERVAL_MS=10000
QUOTA_CHECK_INTERVAL_MS=30000

# Local QA only: admin password honoured only when LOCAL_MODE=1 and ADMIN_PASSWORD_HASH is empty (set it in the untracked .env)
LOCAL_ADMIN_PASSWORD=

# Admin API (/api/admin/*) accepts requests with an Origin header only from the backend's own origin
# (scheme://Host) plus these, comma-separated. Production: https://<backend host>. Local staff view from the
# player page on :8080: http://localhost:8080. Empty = own origin only.
PUBLIC_ORIGIN=

# Security review (AI layer). Session binding: AI_REQUIRE_HOST_TOKEN=1 makes /ai sessions require a live pool hostToken
# of that instance (the page must send hostToken in ai.session.start; CR-AI-06). Leave 0 until the page sends it.
AI_REQUIRE_HOST_TOKEN=0
# Rate limits (defaults shown): visitor turns and recordings per session per minute, renders / dossiers per session
# and per address per 10 min, AR uploads per address per 10 min.
AI_TURNS_PER_SESSION_MIN=15
AI_AUDIO_STARTS_PER_SESSION_MIN=20
AI_RENDER_MAX_PER_SESSION_10MIN=12
AI_RENDER_MAX_PER_IP_10MIN=60
AI_DOSSIER_MAX_PER_SESSION_10MIN=5
AI_DOSSIER_MAX_PER_IP_10MIN=30
AI_AR_MAX_PER_IP_10MIN=30
AI_VISIT_MAX_PER_IP_10MIN=10
# Render give-up (TC-AI-06.2): a photo not finished after this many ms is reported failed (Russian reason).
AI_RENDER_GIVEUP_MS=60000
# QA test hook, LOCAL_MODE only: 1 = the render provider never answers (to verify the give-up path).
AI_RENDER_MOCK_HANG=0
# Retention (QA-058): runtime files older than N days are deleted on start and every AI_RETENTION_INTERVAL_MIN.
# Default on in production, off in LOCAL_MODE (AI_RETENTION_ENABLED=1 forces it). 0 days disables a folder.
# Never touched: leads.jsonl, the spend ledger, index files, catalog, saves.
AI_RETENTION_ENABLED=
AI_RETENTION_DRY_RUN=0
AI_RETENTION_INTERVAL_MIN=60
AI_RETENTION_RENDERS_DAYS=7
AI_RETENTION_CLIPS_DAYS=1
AI_RETENTION_DOSSIERS_DAYS=30
AI_RETENTION_LOGS_DAYS=30
AI_RETENTION_AR_DAYS=30
